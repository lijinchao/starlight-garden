[gd_scene load_steps=4 format=3 uid="uid://game_scene"]

[ext_resource type="Script" path="res://scripts/core/Board.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/LevelSystem.gd" id="2"]

[sub_resource type="GDScript" id="game_ui"]
script/source = "## GameUI - 游戏界面控制器
extends Control

@onready var moves_label = $HUD/MovesLabel
@onready var score_label = $HUD/ScoreLabel
@onready var target_label = $HUD/TargetLabel
@onready var board = $Board

var level_system: Node

func _ready() -> void:
	# 初始化关卡系统
	level_system = preload(\"res://scripts/systems/LevelSystem.gd\").new()
	add_child(level_system)
	
	# 连接信号
	level_system.level_loaded.connect(_on_level_loaded)
	level_system.moves_updated.connect(_on_moves_updated)
	level_system.level_won.connect(_on_level_won)
	level_system.level_failed.connect(_on_level_failed)
	
	board.tiles_matched.connect(_on_tiles_matched)
	
	# 开始第1关
	level_system.start_level(1)

func _on_level_loaded(level_data: Dictionary) -> void:
	moves_label.text = \"步数: %d\" % level_data.get(\"moves\", 30)
	_update_target_display()

func _on_moves_updated(moves_left: int) -> void:
	moves_label.text = \"步数: %d\" % moves_left

func _on_tiles_matched(positions: Array, tile_type: int) -> void:
	# 收集元素
	level_system.collect_tiles(positions.size(), tile_type)
	level_system.use_move()
	level_system.add_score(positions.size() * 10)
	score_label.text = \"分数: %d\" % level_system.current_score
	_update_target_display()

func _update_target_display() -> void:
	target_label.text = level_system.get_target_progress_text()

func _on_level_won(stars: int, score: int) -> void:
	print(\"Level Won! Stars: \", stars, \" Score: \", score)
	# TODO: 显示胜利弹窗

func _on_level_failed() -> void:
	print(\"Level Failed!\")
	# TODO: 显示失败弹窗
"

[node name="GameScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = SubResource("game_ui")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 0
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.98, 0.95, 0.98, 1)

[node name="Board" type="Node2D" parent="."]
position = Vector2(375, 700)
script = ExtResource("1")

[node name="HUD" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 200.0
grow_horizontal = 2

[node name="MovesLabel" type="Label" parent="HUD"]
layout_mode = 2
text = "步数: 30"
horizontal_alignment = 1

[node name="ScoreLabel" type="Label" parent="HUD"]
layout_mode = 2
text = "分数: 0"
horizontal_alignment = 1

[node name="TargetLabel" type="Label" parent="HUD"]
layout_mode = 2
text = "目标: -"
horizontal_alignment = 1
