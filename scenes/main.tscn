[gd_scene format=3 uid="uid://d03h7rkhsbtla"]

[sub_resource type="GDScript" id="main_script"]
script/source = "## MainScene - 主场景控制器
extends Control

var scene_manager: SceneManager

func _ready() -> void:
	print(\"=====================================\")
	print(\"   星光花园 - Starlight Garden\")
	print(\"   版本: 1.0.0 MVP\")
	print(\"=====================================\")
	
	# 动态获取视口大小并设置
	size = get_viewport_rect().size
	
	# 创建场景管理器
	scene_manager = SceneManager.new()
	add_child(scene_manager)
	
	# 连接信号
	scene_manager.scene_changed.connect(_on_scene_changed)

func _on_scene_changed(scene_name: String) -> void:
	print(\"Scene changed to: \", scene_name)
"

[node name="MainScene" type="Control" unique_id=1786492346]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
