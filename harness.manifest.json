{
  "version": "0.1.1",
  "tool": {
    "version": "0.1.1"
  },
  "base": {
    "source": "git:https://github.com/lijinchao/coding-harness.git",
    "registry": "dist",
    "cache": ".harness"
  },
  "compositions": [
    {
      "output": "AGENTS.md",
      "sources": [
        "base:AGENTS.base.md",
        "AGENTS.delta.md"
      ]
    },
    {
      "output": "REVIEW.md",
      "sources": [
        "base:REVIEW.base.md"
      ]
    }
  ],
  "skills": [
    {
      "id": "test-driven-development",
      "path": "base:skills/test-driven-development/SKILL.md",
      "trigger": "before writing implementation code",
      "owner": "@starlight-garden-team"
    },
    {
      "id": "writing-a-gate",
      "path": "base:skills/writing-a-gate/SKILL.md",
      "trigger": "before adding a gate",
      "owner": "@starlight-garden-team"
    }
  ],
  "gates": [
    {
      "id": "harness-drift",
      "command": "node ../coding-harness/bin/harness.mjs check --manifest harness.manifest.json",
      "protects": "the composed AGENTS.md and REVIEW.md match base@0.1.1 plus this repository delta",
      "prove_fires": "hand-edit AGENTS.md, then run harness check; expect exit 1",
      "severity": "blocking"
    }
  ],
  "lock": {
    "version": "0.1.1",
    "tool": {
      "version": "0.1.1"
    },
