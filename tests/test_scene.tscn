[gd_scene load_steps=2 format=3 uid="uid://test_scene"]

[sub_resource type="GDScript" id="test_script"]
script/source = "## TestScene - 测试场景
extends Node2D

var test_runner: TestRunner
const AsyncUtilsScript = preload(\"res://scripts/utils/AsyncUtils.gd\")

func _ready() -> void:
	print(\"\\n🎮 启动测试场景...\")
	
	# 创建测试运行器
	test_runner = preload(\"res://tests/TestRunner.gd\").new()
	add_child(test_runner)
	
	# 连接信号
	test_runner.test_suite_completed.connect(_on_tests_completed)
	
	# 运行测试
	await AsyncUtilsScript.create_delay_tween(self, 0.5).finished
	var results = test_runner.run_all_tests()

func _on_tests_completed(results: Dictionary) -> void:
	if results[\"failed\"] == 0:
		print(\"\\n🎉 所有测试通过！\")
	else:
		print(\"\\n⚠️ 有 %d 个测试失败\" % results[\"failed\"])

	get_tree().quit(results[\"failed\"])
"

[node name="TestScene" type="Node2D"]
script = SubResource("test_script")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.95, 0.95, 0.98, 1)
